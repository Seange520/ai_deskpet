        "task": "QoS 1 大致意味着？",
        "options": [
          "至少送达一次",
          "最多一次",
          "不保证送达"
        ],
        "answerIndex": 0
      }
    },
    {
      "id": "do",
      "seconds": 200,
      "narration": [
        "选对主题和负载，再发一次。",
        "用 QoS 1，等 Broker 回显。"
      ],
      "sim": {
        "id": "mqtt-publish",
        "task": "选对主题与负载，用 QoS 1 发布一帧开关命令。",
        "hints": [
          "主题要对准 lamp1/state",
          "负载用 1 表示开",
          "QoS 选 1"
        ]
      }
    },
    {
      "id": "prove",
      "seconds": 110,
      "mode": "numeric",
      "narration": [
