          "IP 地址",
          "端口号"
        ],
        "answerIndex": 0
      }
    },
    {
      "id": "learn",
      "seconds": 80,
      "narration": [
        "主题写错，订阅者永远收不到。",
        "QoS 决定要不要重发确认。"
      ],
      "media": [
        {
          "kind": "diagram",
          "src": "assets/lessons/K5-03/mqtt-pubsub.svg",
          "alt": "发布订阅与 Broker",
