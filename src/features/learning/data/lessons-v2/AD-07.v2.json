  "segments": [
    {
      "id": "mission",
      "seconds": 25,
      "narration": ["桌宠会动，也会叫。", "点头要准，提示要齐。", "今天的任务：配上节拍。"],
      "task": "把舵机角度换成脉宽，把提示音换成频率与时长，让三次点头和三声提示同拍。"
    },
    {
      "id": "observe",
      "seconds": 55,
      "narration": ["角度靠脉宽说话。", "中位是一点五毫秒。", "再往两边，脉宽加减。"],
      "media": [
        { "kind": "svg", "src": "assets/lessons/AD-07/gesture-tone.svg", "status": "ready", "license": "CC-BY-4.0" }
      ],
      "check": {
        "id": "obs-1",
        "type": "choice",
        "task": "舵机转到 90° 时，控制脉宽约为？",
        "options": ["0.5 ms", "1.5 ms", "2.5 ms"],
        "answerIndex": 1
      }
    },
    {
      "id": "learn",
      "seconds": 85,
      "narration": ["声音的频率决定音高。", "时长决定一声有多长。", "节拍就是彼此等的这段。"],
      "media": [
        { "kind": "svg", "src": "assets/lessons/AD-07/gesture-tone.svg", "status": "ready", "license": "CC-BY-4.0" }
      ],
      "term": { "text": "脉宽", "oneLine": "PWM 一个周期里高电平持续的时间，舵机靠它认角度。" },
      "check": {
        "id": "learn-1",
        "type": "choice",
        "task": "提示音 440 Hz 表示？",
        "options": ["每秒振动 440 次", "每声持续 440 ms", "音量是 440"],
        "answerIndex": 0
      }
    },
    {
      "id": "do",
      "seconds": 200,
      "narration": ["先填角度，看脉宽。", "再定频率和每声长度。", "预演一次，听节拍齐不齐。"],
      "sim": {
        "id": "motion-tone",
        "version": 1,
        "task": "把 90° 舵机换算成 1.5 ms 脉宽，设定 440 Hz 提示音与每声 120 ms，并预演核对节拍。",
        "hints": ["脉宽 = 0.5 + 角度 ÷ 180 × 2（ms）。", "标准提示音是 440 Hz。", "三声提示每声 120 ms，且与三次点头同拍。"]
      }
    },
    {
      "id": "prove",
      "seconds": 100,
      "mode": "numeric",
      "narration": ["把两个数写下来。", "中位脉宽一点五毫秒。", "提示音四百四十赫兹。"],
      "checks": [
        { "id": "servo-pulse", "type": "measurement", "task": "90° 舵机脉宽", "expected": 1.5, "tolerance": 0.05, "unit": "ms" },
        { "id": "tone-pitch", "type": "measurement", "task": "提示音频率", "expected": 440, "tolerance": 5, "unit": "Hz" }
      ]
    },
    {
      "id": "transfer",
      "seconds": 90,
      "narration": ["点头总比声音慢半拍。", "先查指令，还是先查电源？", "你会先看哪里？"],
      "prompt": "桌宠点头总比提示音慢半拍，最先该查什么？",
      "options": ["动作指令的发出顺序与节拍基准", "换一个更大的电源", "把屏幕亮度调高"],
      "answerIndex": 0
    },
    {
      "id": "recap",
      "seconds": 25,
      "narration": ["角度看脉宽。", "音高看频率，节拍看时长。", "同步，是两条通道对齐。"],
      "lines": ["角度看脉宽。", "音高看频率，节拍看时长。", "同步，是两条通道对齐。"]
    }
  ],
