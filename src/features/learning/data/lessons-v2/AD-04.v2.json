      "narration": ["桌宠要感知，先接总线。", "总线上的设备，各有地址。", "今天的任务：把设备都找出来。"],
      "task": "扫描 I2C 总线，记录每个设备的地址，并验证上拉电阻。"
    },
    {
      "id": "observe",
      "seconds": 55,
      "narration": ["两根线：一根送时钟，一根送数据。", "空闲时都被上拉成高电平。", "谁被点名，谁才应答。"],
      "media": [
        { "kind": "svg", "src": "assets/lessons/AD-04/sensor-bus.svg", "status": "ready", "license": "CC-BY-4.0" }
      ],
      "check": {
        "id": "obs-1",
        "type": "choice",
        "task": "I2C 总线需要几根信号线？",
        "options": ["两根", "四根", "一根"],
        "answerIndex": 0
      }
    },
    {
      "id": "learn",
      "seconds": 85,
      "narration": ["地址是门牌号，不能重。", "屏幕常见 0x3C，姿态 0x68。", "上拉缺失，总线会浮空。"],
      "media": [
        { "kind": "svg", "src": "assets/lessons/AD-04/sensor-bus.svg", "status": "ready", "license": "CC-BY-4.0" }
      ],
      "term": { "text": "上拉电阻", "oneLine": "总线空闲时把两根线拉回高电平的电阻。" },
      "check": {
        "id": "learn-1",
        "type": "choice",
        "task": "总线空闲时，SDA 与 SCL 应处于什么电平？",
        "options": ["高电平", "低电平", "浮空"],
        "answerIndex": 0
      }
    },
    {
      "id": "do",
      "seconds": 200,
      "narration": ["从地址表里逐个点名。", "谁应答，谁就在线上。", "地址冲突，先隔离再接回。"],
      "sim": {
        "id": "i2c-scan",
        "version": 1,
        "task": "用扫描器逐个地址查询，记录应答设备并处理一次地址冲突。",
        "hints": ["先确认供电与共地。", "从 0x08 扫到 0x77。", "两个设备同地址时，先拔掉一个复测。"]
      }
