      "narration": ["把硬件条件也记下来。", "上拉四点七千欧，设备两个。", "数字对了，总线才算健康。"],
      "checks": [
        { "id": "pullup", "type": "measurement", "task": "SDA 上拉电阻", "expected": 4700, "tolerance": 100, "unit": "Ω" },
