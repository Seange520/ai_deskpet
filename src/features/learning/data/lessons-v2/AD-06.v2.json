    {
      "id": "mission",
      "seconds": 25,
      "narration": ["屏亮了，还没有脸。", "一只眼睛，八行字节。", "今天的任务：把眼神写进去。"],
      "task": "算清屏幕显存，找到眼睛所在的页，把一帧表情写进帧缓冲。"
    },
    {
      "id": "observe",
      "seconds": 55,
      "narration": ["单色屏按页切开。", "每页八行，页号从零起。", "改脸，就是改这些字节。"],
      "media": [
        { "kind": "svg", "src": "assets/lessons/AD-06/oled-framebuffer.svg", "status": "ready", "license": "CC-BY-4.0" }
