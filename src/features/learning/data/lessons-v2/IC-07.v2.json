        "options": ["Vref（略低一点）", "Vref/2", "0V"],
        "answerIndex": 0
      }
    },
    {
      "id": "learn",
      "seconds": 85,
      "narration": ["权重相加就是输出。", "B3=8、B2=4、B1=2、B0=1。", "除以 16，再乘 Vref。"],
      "media": [
        { "kind": "svg", "src": "assets/lessons/IC-07/dac-ladder.svg", "status": "ready", "license": "CC-BY-4.0" }
      ],
      "term": { "text": "分辨率", "oneLine": "N 位 DAC 把 Vref 分成 2^N 份，1 LSB = Vref/2^N。" },
      "check": {
        "id": "learn-1",
        "type": "choice",
        "task": "输入码 1000（8）时，4 位 DAC 输出约是？",
        "options": ["1.65V（Vref 的一半）", "3.3V", "0.8V"],
        "answerIndex": 0
      }
    },
    {
      "id": "do",
      "seconds": 200,
      "narration": ["拨 1000，读 1.65 伏。", "拨 1111，读 3.09 伏。", "再把最小步进算出来。"],
      "sim": {
        "id": "dac-ladder",
        "version": 1,
        "task": "拨 4 位开关，写下两个码对应的输出，并算 1 LSB。",
        "hints": ["码值 = B3×8 + B2×4 + B1×2 + B0×1。", "输出 = 码值 / 16 × 3.3V。", "1 LSB = 3.3V / 16 ≈ 0.206V。"]
      }
    },
    {
      "id": "prove",
      "seconds": 100,
