  "kp": {
    "id": "K6-03",
    "name": "安全联锁与限位",
    "layer": "L6",
    "pillar": "craft",
    "oneLiner": "机器会伤人，联锁先装",
    "prereq": [
      "K6-01"
    ],
    "storyScene": "P10-CraftWorkshop",
    "spoilerLevel": 6,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 10,
    "template": "six-segment-v1",
    "gameMount": "craft-workshop"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 40,
      "narration": "意匠工坊的检修门开着，机械臂却还在动。赫菲按住急停：门开着就不该有动力——哪一根线该先断？",
      "interaction": "choice",
      "choices": [
        {
          "id": "a",
          "text": "在代码里加一句「门开就 return」",
          "correct": false,
          "feedback": "软件会卡死、会被绕过，不能作为唯一防线。"
        },
        {
          "id": "b",
          "text": "把门磁串进动力回路，门开即断电，软件再补状态",
          "correct": true,
          "feedback": "对。硬件联锁兜底，软件只做提示与恢复。"
        },
        {
          "id": "c",
          "text": "贴一张「开门勿动」的警告贴纸",
          "correct": false,
          "feedback": "警告不能代替联锁。"
        }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "安全联锁的原则是「失效即安全」：门磁、限位、急停这些开关串在动力回路里，断线、断电、卡死都导向停止，而不是继续动。联锁不做成可选项，也不依赖屏幕上的确认。软件负责提示、记录与复位流程，但不能替代硬约束。限位开关负责「走到头就停」，急停负责「任何时刻都能停」，门禁负责「人不在危险区」。",
      "media": [
        {
          "kind": "card",
          "src": "assets/lessons/K6-03/interlock-card.svg",
          "alt": "门磁/限位/急停串入动力回路的三种联锁接法",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        },
        {
          "kind": "diagram",
          "src": "assets/lessons/K6-03/interlock-sim.svg",
          "alt": "检修门开合仿真：门开→动力 0V，复位需重新关门",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 200,
      "task": "给检修门加联锁：门开→驱动断电；门关+复位后→允许上电。",
      "steps": [
        {
          "action": "inspect",
          "target": "door-switch",
          "hint": "确认门磁是常闭还是常开"
        },
        {
          "action": "code",
          "target": "wire-interlock",
          "hint": "联锁串在动力回路，不是只写软件"
        },
        {
          "action": "measure",
          "target": "drive-voltage-door-open",
          "hint": "门开时驱动电压应为 0V"
        }
      ],
      "failureHints": [
        "只写软件锁：绕过界面就能继续动",
        "联锁接成常开：断线时反而上电",
        "复位逻辑自动清除：人还没离开危险区机器就恢复"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 150,
      "checks": [
        {
          "id": "v_voltage",
          "type": "measurement",
          "probe": "drive_voltage_door_open",
          "expected": 0,
          "tolerance": 0.1,
          "unit": "V"
        },
        {
          "id": "v_trip",
          "type": "measurement",
          "probe": "limit_trip_ms",
          "expected": 40,
          "tolerance": 10,
          "unit": "ms"
        }
      ],
      "safety": "教学仿真；真实设备联锁必须由具备资质的人员按安全标准设计与验证，断电挂牌后再检修。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "软件判断、硬件联锁、人工巡检，三者的优先级应该怎么排？",
      "options": [
        {
          "id": "a",
          "text": "硬件联锁兜底 > 软件判断 > 人工巡检（补充）",
          "correct": true,
          "why": "硬约束不依赖程序与注意力。"
        },
        {
          "id": "b",
          "text": "软件判断 > 硬件联锁 > 人工巡检",
          "correct": false,
          "why": "软件会死机、会被绕过。"
        },
        {
          "id": "c",
          "text": "人工巡检最重要，其他都是辅助",
          "correct": false,
          "why": "人的注意力不可靠，不能作为唯一防线。"
        }
      ],
      "solution": "安全先做硬约束，再做软件提示，最后用巡检补漏。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "机器会伤人，联锁先装。",
        "失效即安全：断线、断电都导向停止。",
        "硬件兜底，软件只做提示与恢复。"
      ]
    }
  ],
  "checks": [
