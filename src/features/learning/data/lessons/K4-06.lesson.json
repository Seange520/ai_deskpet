{
  "schema": "lesson.v1",
  "lessonId": "L-K4-06",
  "kp": {
    "id": "K4-06",
    "name": "总线排障",
    "layer": "L4",
    "pillar": "weave",
    "oneLiner": "先分段，再二分",
    "prereq": [
      "K4-02",
      "K4-03"
    ],
    "storyScene": "P10-WeaveCase",
    "spoilerLevel": 4,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "weave-corridor"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 40,
      "narration": "整条总线突然没人说话：主设备在发，八个从机一个都不应。你手里只有万用表和地址表——第一刀切在哪里？",
      "interaction": "choice",
      "choices": [
        {
          "id": "a",
          "text": "从中间断开，先判断坏在前半段还是后半段",
          "correct": true,
          "feedback": "对。二分能把范围一步步减半。"
        },
        {
          "id": "b",
          "text": "从第一个设备开始一个个拆",
          "correct": false,
          "feedback": "能找到，但多花几倍时间。"
        },
        {
          "id": "c",
          "text": "先把所有设备换新再试",
          "correct": false,
          "feedback": "这不是排障，是赌博。"
        }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "总线排障有三件工具：万用表通断（断电查断线/短路）、电压档（上电看 SDA/SCL 是否被拉死）、地址表（看谁在应）。顺序是「先分段，再二分」：把总线从中间断开，分别判断哪一半正常；再对坏的那半继续二分。常见四因：短路、断线、地址冲突、上拉缺失。不要一上来全拆——每多拆一次，就多一个变量。",
      "media": [
        {
          "kind": "diagram",
          "src": "assets/lessons/K4-06/bisect-bus.svg",
          "alt": "8 节点总线二分排查示意：中点断开、判断半段、继续二分",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        },
        {
          "kind": "diagram",
          "src": "assets/lessons/K4-06/bus-fault.svg",
          "alt": "总线故障仿真：通断分段、上电测电平、定位断线节点",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 200,
      "task": "在案例总线上定位断线节点：断电分段→缩到单段→上电测电平→确认坏节点 ID。",
      "steps": [
        {
          "action": "segment",
          "target": "bus-segment",
          "hint": "先从中间断开，不要全拆"
        },
        {
          "action": "continuity",
          "target": "bus-continuity",
          "hint": "断电测通断，确认断在哪半"
        },
        {
          "action": "volt",
          "target": "bus-idle-level",
          "hint": "上电测 SDA/SCL 空闲电平"
        },
        {
          "action": "locate",
          "target": "bus-node",
          "hint": "锁定单个节点后记录编号"
        }
      ],
      "failureHints": [
        "带电测通断：联锁阻止并记一次错误",
        "一次拆掉全部节点：变量太多，无法归因",
        "只看电压不验通断：断线也可能读数虚高"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 140,
      "checks": [
        {
          "id": "v_node",
          "type": "measurement",
          "probe": "bus_broken_node",
          "expected": "U5",
          "tolerance": 0,
          "unit": "id"
        },
        {
          "id": "v_sda",
          "type": "measurement",
          "probe": "bus_sda_idle",
          "expected": 3.3,
          "tolerance": 0.2,
          "unit": "V"
        },
        {
          "id": "v_restore",
          "type": "measurement",
          "probe": "bus_read_ok",
          "expected": 1,
          "tolerance": 0,
          "unit": "bool"
        }
      ],
      "safety": "分段前必须断电，改线完成后再上电；真实总线禁止带电插拔，SDA/SCL 上拉与电平按设备手册核对。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "8 个设备一条总线，只有 1 个节点坏。用二分法，最少需要几次「断开/合上」检查才能锁定？",
      "options": [
        {
          "id": "a",
          "text": "3 次（8→4→2→1）",
          "correct": true,
          "why": "每次对半缩小，2³=8，所以 3 次足够。"
        },
        {
          "id": "b",
          "text": "8 次，每个都要试",
          "correct": false,
          "why": "逐步拆是线性排查，不是二分。"
        },
        {
          "id": "c",
          "text": "1 次，直接测中间那个",
          "correct": false,
          "why": "一次只能把范围减半，不能直接命中。"
        }
      ],
      "solution": "先把 8 分 4/4，再 2/2，再 1/1，共 3 次检查即可锁定。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "先分段，再二分。",
        "通断查断线，电压查电平，地址表查冲突。",
        "每多拆一次，就多一个变量。"
      ]
    }
  ],
  "checks": [
    {
      "id": "s1",
      "type": "sim-task",
      "weight": 0.5,
      "pass": "二分路径正确并锁定断线节点"
    },
    {
      "id": "m1",
      "type": "measurement",
      "weight": 0.25,
