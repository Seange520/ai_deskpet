{
  "schema": "lesson.v1",
  "lessonId": "L-K7-01",
  "kp": {
    "id": "K7-01",
    "name": "AI是什么",
    "layer": "L7",
    "pillar": "symbiosis",
    "oneLiner": "数据进，推理出，结果要对",
    "prereq": ["K3-01"],
    "storyScene": "P10-SymbiosisGreenhouse",
    "spoilerLevel": 7,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 10,
    "template": "six-segment-v1",
    "gameMount": "greenhouse-classifier"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 40,
      "narration": "共生温室里，分类器把一株新芽标成了「枯叶」。零说它「看错了」，可它到底在看什么？",
      "interaction": "choice",
      "choices": [
        { "id": "a", "text": "它只是猜的，关了就好", "correct": false, "feedback": "它按训练数据的规律在预测，不是随机猜。" },
        { "id": "b", "text": "它从样本里学了特征，用这些特征做判断", "correct": true, "feedback": "对。先看它学了什么，再看它漏了什么。" },
        { "id": "c", "text": "加一句「你错了」，它就会改", "correct": false, "feedback": "模型不会因为一句话改参数，需要样本与训练。" }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "AI 不是魔法，是「从数据里找规律，再用规律做预测」。流程是：数据→特征→模型→预测；训练集学规律，测试集验效果，两者不能混。置信度是模型对自己答案的把握，不是正确率。数据偏了，模型会偏；样本不够，边界就会糊。判断一个 AI 可不可信，先问三件事：训练数据是什么、测试怎么做的、错了会怎样。",
      "media": [
        {
          "kind": "card",
          "src": "assets/lessons/K7-01/ai-pipeline.svg",
          "alt": "数据→特征→模型→预测→评估的流程图，标注训练/测试分离",
          "status": "planned",
          "license": "original",
          "notes": "原创卡片，UI 内联"
        },
        {
          "kind": "animation",
          "src": "assets/lessons/K7-01/classifier-boundary.mp4",
          "alt": "12 秒动画：决策边界随样本增加而变化，边界附近样本置信度低",
          "status": "planned",
          "license": "original",
          "notes": "原创动画，字幕"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 200,
      "task": "用 20 条样本训练一个二分类器，观察边界样本的置信度并标出低置信样本。",
      "steps": [
        { "action": "code", "target": "train-classifier", "hint": "先分训练/测试，不要用测试集调参" },
        { "action": "measure", "target": "test-accuracy", "hint": "准确率 = 猜对的样本数 / 测试样本数" },
        { "action": "inspect", "target": "low-confidence", "hint": "置信度低的样本通常靠近边界" }
      ],
      "failureHints": [
        "拿测试集训练：准确率虚高",
        "只报准确率不看边界：错误集中在少数类别上",
        "把置信度当正确率：高置信也会错"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 150,
      "checks": [
        { "id": "v_acc", "type": "measurement", "probe": "classifier_test_accuracy", "expected": 0.8, "tolerance": 0.05, "unit": "ratio" },
        { "id": "v_low", "type": "measurement", "probe": "low_confidence_samples", "expected": 3, "tolerance": 1, "unit": "samples" }
      ],
      "safety": "教学使用合成小样本与本地分类器；真实数据须做隐私与偏置评估。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "分类器、规则引擎、人类专家，分别在什么场景更可靠？",
      "options": [
        { "id": "a", "text": "规则清晰的用规则；模式识别用分类器；责任与边界判断用人类", "correct": true, "why": "三类工具各有所长，关键看边界是否清晰。" },
        { "id": "b", "text": "全部交给分类器，人类只需要点确认", "correct": false, "why": "分类器不负责责任与边界。" },
        { "id": "c", "text": "全部用规则，AI 只是噱头", "correct": false, "why": "规则写不出模糊模式的识别。" }
      ],
      "solution": "先问「边界清不清、错了谁负责」，再选工具。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "数据进，推理出，结果要对。",
        "训练和测试要分开；置信度不是正确率。",
        "先问数据、测试、错了会怎样。"
      ]
    }
  ],
  "checks": [
    { "id": "q1", "type": "quiz", "weight": 0.5, "pass": "能解释分类器从数据到预测的流程与偏差来源" },
    { "id": "m1", "type": "measurement", "weight": 0.3, "pass": "测试准确率 0.8±0.05、低置信样本 ≥3" },
    { "id": "q2", "type": "quiz", "weight": 0.2, "pass": "能区分置信度与正确率" }
  ],
  "assessment": {
    "masteryWeights": { "hook": 0.1, "practice": 0.3, "verify": 0.3, "transfer": 0.3 },
    "passScore": 0.7,
    "retentionDays": [1, 3, 7, 21]
  },
  "storyBinding": {
    "scene": "P10-SymbiosisGreenhouse",
    "npc": "零",
    "dialogueHint": "你先看它学了什么，再问它为什么。",
    "worldPhenomenon": "温室里那台老分类器把新芽标成了枯叶。"
  },
  "redLines": {
    "forbiddenNarrationTokens": ["第七校验", "熵", "残响", "第一编译者", "网页游戏"],
    "aiDoesNotDecide": true,
    "noFourthWall": true,
    "noSacrificeGlorification": true
  },
