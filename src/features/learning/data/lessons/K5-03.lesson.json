  "kp": {
    "id": "K5-03",
    "name": "MQTT主题负载QoS",
    "layer": "L5",
    "pillar": "echo",
    "oneLiner": "发对主题，才有人听",
    "prereq": ["K5-01"],
    "storyScene": "P10-PacketPuzzle2",
    "spoilerLevel": 4,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "echo-market"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 35,
      "narration": "发布端显示「已发送」，订阅端一条也没收到。弥看了一眼主题：你喊的名字，没人订阅。",
      "interaction": "choice",
      "choices": [
        { "id": "a", "text": "先核对主题层级与通配符，再看负载", "correct": true, "feedback": "对。MQTT 先对主题，再对格式。" },
        { "id": "b", "text": "把 QoS 调到 2 就一定收到", "correct": false, "feedback": "QoS 保的是投递质量，不是名字对错。" },
        { "id": "c", "text": "换一个 MQTT broker", "correct": false, "feedback": "主题不匹配，换 broker 也一样收不到。" }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 95,
      "narration": "MQTT 是「主题—负载」的发布/订阅：发布者发到主题，订阅者按主题收。主题用斜杠分层，如 `p10/street/lamp`；`+` 匹配一层，`#` 匹配剩余所有层。负载（payload）常是 JSON 或纯值。QoS 决定投递语义：0 至多一次（可能丢）、1 至少一次（可能重复）、2 恰好一次（开销最大）。retain 让新订阅者立刻收到最后一条；遗嘱消息在客户端异常断开时代发。",
      "media": [
        {
          "kind": "diagram",
          "src": "assets/lessons/K5-03/mqtt-topic-tree.svg",
          "alt": "MQTT 主题树与 +/# 通配匹配示意",
          "status": "planned",
          "license": "original",
          "notes": "原创 SVG，UI 内联"
        },
        {
          "kind": "simulation",
          "src": "assets/lessons/K5-03/mqtt-pubsub.json",
          "alt": "发布订阅仿真：拼主题、选 QoS、观察订阅端是否收到",
          "status": "planned",
          "license": "original",
          "notes": "页面内确定性仿真"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 205,
      "task": "在报文拼图台：发布 `p10/street/lamp`，订阅 `p10/street/+`，再判断 QoS 1 下是否有确认。",
      "steps": [
        { "action": "publish", "target": "mqtt-publish", "hint": "主题层级不能拼错" },
        { "action": "subscribe", "target": "mqtt-subscribe", "hint": "通配符只匹配整层" },
        { "action": "qos", "target": "mqtt-qos", "hint": "1 表示至少一次，需要 PUBACK" },
        { "action": "payload", "target": "mqtt-payload", "hint": "负载格式两边要约定" }
      ],
      "failureHints": [
        "订阅 `p10/+` 却以为能收到两层主题：+ 只匹配一层",
        "主题末尾多一个斜杠：变成两个不同主题",
        "QoS 0 丢包就责怪 broker：语义本就不保证送达"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 140,
      "checks": [
        { "id": "v_match", "type": "measurement", "probe": "mqtt_topic_match", "expected": 1, "tolerance": 0, "unit": "bool" },
        { "id": "v_payload", "type": "measurement", "probe": "mqtt_payload_ok", "expected": 1, "tolerance": 0, "unit": "bool" },
        { "id": "v_qos", "type": "measurement", "probe": "mqtt_qos_level", "expected": 1, "tolerance": 0, "unit": "level" }
      ],
      "safety": "教学仿真连本地 broker；真实部署须使用鉴权与 TLS，主题命名避免泄露设备信息，禁止把口令放进主题或负载明文。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "订阅 `p10/#` 与订阅 `p10/+/lamp`，各能收到哪些主题？",
      "options": [
        { "id": "a", "text": "前者收 p10 下所有层；后者只收 p10/<一层>/lamp", "correct": true, "why": "# 覆盖多级，+ 只占一层。" },
        { "id": "b", "text": "两者完全一样", "correct": false, "why": "通配符范围不同。" },
        { "id": "c", "text": "后者能收 p10/street/room/lamp", "correct": false, "why": "多了 room 一层，+ 只能匹配一层。" }
      ],
      "solution": "`p10/#` 收 p10 下全部层级；`p10/+/lamp` 只收「p10/任意一层/lamp」，如 p10/street/lamp。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "发对主题，才有人听。",
        "`+` 一层，`#` 余下所有层。",
        "QoS 保投递，不保主题正确。"
      ]
    }
  ],
  "checks": [
    { "id": "s1", "type": "sim-task", "weight": 0.5, "pass": "发布/订阅主题匹配与 QoS 选择正确" },
    { "id": "q1", "type": "quiz", "weight": 0.3, "pass": "QoS 0/1/2 语义与通配符范围判断正确" },
    { "id": "m1", "type": "measurement", "weight": 0.2, "pass": "主题匹配、负载一致、QoS 等级正确" }
  ],
