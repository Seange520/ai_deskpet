    "name": "用电安全与断电原则",
    "layer": "L0",
    "pillar": "foundation",
    "oneLiner": "先断电再动手，命比灯重要",
    "prereq": [],
    "storyScene": "P10-MaintenanceRoom",
    "spoilerLevel": 0,
    "license": "CC-BY-4.0",
    "status": "sample"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
