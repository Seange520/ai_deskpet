    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "p10-cold-storage"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 40,
      "narration": "继电器一断开，冷库控制器就重启，屏幕闪一下黑。赫菲说：不是控制器娇气，是线圈在断电那一瞬反咬了一口。",
      "interaction": "choice",
      "choices": [
        { "id": "a", "text": "换个更大功率的控制器，扛住这一下", "correct": false, "feedback": "反峰电压可能远超器件额定，硬扛只会更贵。" },
        { "id": "b", "text": "给线圈一条断电时的泄放路径", "correct": true, "feedback": "对。续流或吸收，把能量引到安全的地方。" },
        { "id": "c", "text": "把继电器换成固态继电器就好", "correct": false, "feedback": "换器件不改变电感储能这一物理事实。" }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "线圈是电感，电流不能瞬间归零。断开时电流急速下降，L·di/dt 把电压推高：Vpk = Vs + L·I/Δt。教学模型里 24V、0.12H、0.6A、0.5ms 可冲到两百多伏。续流二极管把线圈能量沿反向路径泄放，阴极接正侧；RC 吸收把尖峰压到更低。保护不是可选项，是驱动回路的一部分。",
      "media": [
        {
          "kind": "card",
          "src": "assets/lessons/K6-01/flyback-card.svg",
          "alt": "线圈断电反峰与续流二极管/RC 吸收两种钳位路径",
          "status": "planned",
          "license": "original",
          "notes": "原创卡片，UI 内联"
        },
        {
          "kind": "sim",
          "src": "assets/lessons/K6-01/flyback-sim.json",
          "alt": "M1 冷库支路仿真：断开开关观察 U1 复位与线圈峰值",
          "status": "planned",
          "license": "original",
          "notes": "确定性教学模型，非真实认证曲线"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 210,
      "task": "在冷库支路给继电器线圈补一条续流路径，连续分断 3 次观察控制器是否还复位。",
      "steps": [
        { "action": "inspect", "target": "coil-and-driver", "hint": "先找线圈两端与驱动管脚" },
        { "action": "code", "target": "fit-flyback", "hint": "二极管阴极接正侧，或 RC 并在线圈两端" },
        { "action": "measure", "target": "coil-peak", "hint": "加保护后峰值应降到几十伏以内" }
      ],
      "failureHints": [
        "二极管方向反了：上电即短路，保险丝先断",
        "只加软件延时：断开瞬间的尖峰不理软件",
        "RC 取值过大：钳位不足，U1 仍然复位"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 150,
      "checks": [
        { "id": "v_peak", "type": "measurement", "probe": "coil_peak_voltage", "expected": 24.7, "tolerance": 1.0, "unit": "V" },
        { "id": "v_current", "type": "measurement", "probe": "motor_current", "expected": 0.8, "tolerance": 0.1, "unit": "A" }
      ],
      "safety": "教学仿真为确定性模型；真实电机/继电器断电前先断主电源，续流二极管注意极性与耐压。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "继电器、有刷电机、电磁阀、LED 灯带，哪些断电时必须考虑反峰？",
      "options": [
        { "id": "a", "text": "继电器、电机、电磁阀都要；LED 灯带不是电感负载，主要看驱动", "correct": true, "why": "前三个都有线圈，LED 灯带按驱动方式评估。" },
        { "id": "b", "text": "只有电机会反峰，其它不用管", "correct": false, "why": "继电器与电磁阀同样有线圈。" },
        { "id": "c", "text": "全部都要加续流二极管，包括 LED 灯带", "correct": false, "why": "续流针对电感；LED 灯带加错位置会短路驱动。" }
      ],
      "solution": "先问「里面有没有线圈」，再决定续流或吸收。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "电感断电会反咬一口：Vpk = Vs + L·I/Δt。",
        "续流二极管或 RC 吸收把能量引走。",
        "先加保护，再上电；方向反了保险丝先断。"
      ]
    }
  ],
  "checks": [
