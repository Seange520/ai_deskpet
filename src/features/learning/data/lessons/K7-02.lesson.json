{
  "schema": "lesson.v1",
  "lessonId": "L-K7-02",
  "kp": {
    "id": "K7-02",
    "name": "视觉语音LLM边界",
    "layer": "L7",
    "pillar": "symbiosis",
    "oneLiner": "AI会答，但不是神",
    "prereq": [
      "K7-01"
    ],
    "storyScene": "P10-ZeroDialogue",
    "spoilerLevel": 7,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 10,
    "template": "six-segment-v1",
    "gameMount": "zero-dialogue"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 40,
      "narration": "零能写诗、能认图，可你问它「这根线接哪」，它要给你一个答案还是说「我不知道」？",
      "interaction": "choice",
      "choices": [
        {
          "id": "a",
          "text": "让它答，答错再纠正",
          "correct": false,
          "feedback": "工程接错线可能烧设备，不能先用错误答案试错。"
        },
        {
          "id": "b",
          "text": "让它明确说不知道，并给出下一步该测什么",
          "correct": true,
          "feedback": "对。边界要写进产品行为，而不是靠态度。"
        },
        {
          "id": "c",
          "text": "把问题重复三遍，它就会答对",
          "correct": false,
          "feedback": "重复不会创造证据。"
        }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "AI 的回答是概率性的生成，不是测量。它能认图、能转写语音、能解释概念，但不能替你读万用表、不能保证接线正确、不能为安全负责。工程语境里要给它边界：用知识库和工具调用把答案拉回证据；越级问题必须拒答并给出正确下一步；关键操作保留人工确认。边界不是给 AI 的枷锁，是给用户的保护。",
      "media": [
        {
          "kind": "card",
          "src": "assets/lessons/K7-02/ai-boundary-card.svg",
          "alt": "AI 能力分层：感知/解释/建议/决策，标注哪一层必须人做",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        },
        {
          "kind": "diagram",
          "src": "assets/lessons/K7-02/zero-boundary-sim.svg",
          "alt": "三个越界问题对话仿真：AI 明确拒答并给下一步",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 200,
      "task": "给零三个越界问题（接线/测量/安全判断），要求它明确说不知道，并给出正确的下一步。",
      "steps": [
        {
          "action": "ask",
          "target": "boundary-questions",
          "hint": "越界问题要涉及测量与安全"
        },
        {
          "action": "inspect",
          "target": "refusal-reason",
          "hint": "好的拒答会说明「需要什么证据」"
        },
        {
          "action": "code",
          "target": "boundary-policy",
          "hint": "把「不知道+下一步」写进系统提示与产品文案"
        }
      ],
      "failureHints": [
        "AI 编一个引脚号：看起来专业，实则危险",
        "AI 拒答但不给下一步：用户卡住",
        "把所有问题都拒答：AI 失去价值"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 150,
      "checks": [
        {
          "id": "v_escalation",
          "type": "measurement",
          "probe": "ai_overreach_answers",
          "expected": 0,
          "tolerance": 0,
          "unit": "times"
        },
        {
          "id": "v_next",
          "type": "measurement",
          "probe": "ai_next_step_offers",
          "expected": 3,
          "tolerance": 0,
          "unit": "times"
        }
      ],
      "safety": "教学仿真；真实 AI 接入须有服务端配额、内容审核与人工申诉通道。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "语音助手、图像识别、工程测量，哪些能交给 AI，哪些必须人测？",
      "options": [
        {
          "id": "a",
          "text": "语音转写、图像初筛可交 AI；电压/电阻/安全判断必须人测",
          "correct": true,
          "why": "感知与初筛可以辅助，测量与安全责任必须落在人身上。"
        },
        {
          "id": "b",
          "text": "都可以交 AI，人只负责点确认",
          "correct": false,
          "why": "点确认不是测量，也不是担责。"
        },
        {
          "id": "c",
          "text": "都必须人做，AI 帮不上忙",
          "correct": false,
          "why": "AI 在转写、检索、初筛上能显著提效。"
        }
      ],
      "solution": "把 AI 放在「感知/解释/建议」层，把「测量/决策/安全」留给人。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "AI 会答，但不是神。",
        "越级问题：明确拒答+给下一步。",
        "测量、决策、安全，留给人。"
      ]
    }
  ],
  "checks": [
    {
      "id": "e1",
      "type": "explain",
      "weight": 0.4,
      "pass": "能说明 AI 在工程语境中的能力边界"
