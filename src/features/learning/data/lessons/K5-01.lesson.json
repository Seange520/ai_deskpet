{
  "schema": "lesson.v1",
  "lessonId": "L-K5-01",
  "kp": {
    "id": "K5-01",
    "name": "WiFi连接与状态",
    "layer": "L5",
    "pillar": "echo",
    "oneLiner": "联网先看状态灯",
    "prereq": [
      "K3-02"
    ],
    "storyScene": "P10-EchoMarket",
    "spoilerLevel": 4,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "echo-market"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 35,
      "narration": "回声集市的路由器就在两米外，可灯一直是红的。弥敲了敲外壳：别急着骂网络，先看它停在哪一步。",
      "interaction": "choice",
      "choices": [
        {
          "id": "a",
          "text": "先读状态：扫描、认证、拿地址、已连接",
          "correct": true,
          "feedback": "对。状态机停在哪一步，就查哪一步。"
        },
        {
          "id": "b",
          "text": "关掉再开，反复重连十次",
          "correct": false,
          "feedback": "重启不产生证据，只会把问题藏起来。"
        },
        {
          "id": "c",
          "text": "直接拆开路由器改天线",
          "correct": false,
          "feedback": "射频不是这样修的。"
        }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 95,
      "narration": "WiFi 连接是一个状态机：扫描 → 认证（密码/加密方式）→ 请求 IP（DHCP）→ 已连接。状态灯只告诉你结果，日志才告诉你停在哪。连接质量看 RSSI：一般 -50dBm 很好，-70dBm 边缘，-80dBm 以下容易掉。失败时先分清三类：找不到 SSID（信道/距离/2.4G 与 5G 选错）、认证失败（密码/WPA 模式）、拿到关联却无 IP（DHCP 失败）。",
      "media": [
        {
          "kind": "diagram",
          "src": "assets/lessons/K5-01/wifi-state-machine.svg",
          "alt": "WiFi 连接状态机：扫描、认证、DHCP、已连接与失败分支",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        },
        {
          "kind": "diagram",
          "src": "assets/lessons/K5-01/wifi-connect.svg",
          "alt": "联网仿真：输入 SSID/密码，观察状态与 RSSI 变化",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 200,
      "task": "在回声集市终端上完成一次连接：选对 SSID、输入口令、等待获取 IP、读取 RSSI，并模拟一次失败重连。",
      "steps": [
        {
          "action": "scan",
          "target": "wifi-scan",
          "hint": "先确认能看到目标 SSID"
        },
        {
          "action": "auth",
          "target": "wifi-auth",
          "hint": "加密方式要匹配 WPA2/WPA3"
        },
        {
          "action": "dhcp",
          "target": "wifi-ip",
          "hint": "拿到 IP 才算真正连上"
        },
        {
          "action": "rssi",
          "target": "wifi-rssi",
          "hint": "读 RSSI 并判断信号质量"
        }
      ],
      "failureHints": [
        "SSID 选到 5G：设备只支持 2.4G，永远扫不到",
        "密码对但加密方式选错：认证阶段失败",
        "连上却没有 IP：检查 DHCP 与地址池"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 140,
      "checks": [
        {
          "id": "v_state",
          "type": "measurement",
          "probe": "wifi_state",
          "expected": "connected",
          "tolerance": 0,
          "unit": "state"
        },
        {
          "id": "v_rssi",
          "type": "measurement",
          "probe": "wifi_rssi",
          "expected": -55,
          "tolerance": 10,
          "unit": "dBm"
        },
        {
          "id": "v_ip",
          "type": "measurement",
          "probe": "wifi_ip_ok",
          "expected": 1,
          "tolerance": 0,
          "unit": "bool"
        }
      ],
      "safety": "教学仿真不连接真实网络；真实设备配网前须确认供电与天线，禁止带电插拔模块，WiFi 口令不写入前端代码或日志。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "设备放在贴墙角落，2.4G 信号很弱。不换路由器，给出两种改法。",
      "options": [
        {
          "id": "a",
          "text": "把设备挪离墙角/金属，或换用更空闲的 2.4G 信道",
          "correct": true,
          "why": "位置与信道是成本最低的两刀。"
        },
        {
          "id": "b",
          "text": "把发射功率调到最大就行",
          "correct": false,
          "why": "功率有上限，墙体衰减不归功率管。"
        },
        {
          "id": "c",
          "text": "换成 5G 就一定更好",
          "correct": false,
          "why": "5G 穿墙更差，距离近才占优。"
        }
      ],
      "solution": "挪位置（离地、离金属、避开墙角）或改信道；仍不够再加中继/AP。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "先看灯，再读状态日志。",
        "扫描、认证、DHCP、已连接——停在哪一步查哪一步。",
        "RSSI 决定稳不稳，位置和信道往往比功率有用。"
      ]
    }
  ],
  "checks": [
    {
      "id": "c1",
      "type": "code",
      "weight": 0.4,
      "pass": "连接流程代码正确（SSID/口令/状态读取）"
    },
    {
      "id": "m1",
      "type": "measurement",
      "weight": 0.3,
      "pass": "RSSI 读数在 -55 ± 10dBm、状态为已连接"
    },
    {
      "id": "q1",
      "type": "quiz",
      "weight": 0.3,
      "pass": "状态机阶段与 WPA2/WPA3 判断正确"
    }
  ],
  "assessment": {
