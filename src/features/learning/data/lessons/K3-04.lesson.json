{
  "schema": "lesson.v1",
  "lessonId": "L-K3-04",
  "kp": {
    "id": "K3-04",
    "name": "条件与循环",
    "layer": "L3",
    "pillar": "craft",
    "oneLiner": "循环是让灯呼吸的肺",
    "prereq": [
      "K3-03"
    ],
    "storyScene": "P10-ForgeLamp",
    "spoilerLevel": 3,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "forge-lamp"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 40,
      "narration": "熔炉外的灯只亮不灭，像一只不会呼吸的铁肺。赫菲把控制盒推给你：让它「吸气—呼气」循环起来，你要重复哪个动作、又在什么时候判断该换？",
      "interaction": "choice",
      "choices": [
        {
          "id": "a",
          "text": "把「亮」写成两遍，灯就会呼吸",
          "correct": false,
          "feedback": "重复亮没有边界，灯只会一直亮着。"
        },
        {
          "id": "b",
          "text": "循环里成对地执行「亮一下、灭一下」，并判断次数或时间",
          "correct": true,
          "feedback": "对。循环要有边界，亮灭要成对。"
        },
        {
          "id": "c",
          "text": "换一颗更亮的灯珠",
          "correct": false,
          "feedback": "换灯珠解决亮度，不解决节奏。"
        }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "循环把「重复」写成结构：for 适合已知次数，while 适合等条件。终止条件写错，灯会卡在某一态；循环体里每个动作都要有配对——亮之后必须灭，开之后必须关。判断用 if：时间到了没有、次数用完没有。循环不改变硬件，只改变时间的组织方式。",
      "media": [
        {
          "kind": "diagram",
          "src": "assets/lessons/K3-04/loop-flow.svg",
          "alt": "for/while 循环与 if 判断的流程图，标注终止条件与亮灭配对",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        },
        {
          "kind": "animation",
          "src": "assets/lessons/K3-04/breathing-loop.svg",
          "alt": "12 秒无旁白动画：循环 3 次亮灭，灯两端电压方波与计时器同步",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 210,
      "task": "在熔炉灯控制盒上写一个循环：亮 0.5 秒、灭 0.5 秒，重复 3 次后用万用表观察灯两端电压。",
      "steps": [
        {
          "action": "code",
          "target": "loop-blinking",
          "hint": "用 for 循环 3 次，循环体内成对写亮/灭"
        },
        {
          "action": "measure",
          "target": "lamp-loop-voltage",
          "hint": "亮时约为高电平，灭时接近 0V"
        },
        {
          "action": "inspect",
          "target": "loop-trace",
          "hint": "看方波是否等宽、是否有 3 个周期"
        }
      ],
      "failureHints": [
        "只写亮不写灭：灯一直亮，方波没有下降沿",
        "循环次数写成无限：合上电源后灯持续闪且停不下来",
        "时间写成 5 秒：周期变长，3 次呼吸看起来像坏了"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 150,
      "checks": [
        {
          "id": "v_peak",
          "type": "measurement",
          "probe": "loop_peak_voltage",
          "expected": 3.3,
          "tolerance": 0.2,
          "unit": "V"
        },
        {
          "id": "v_period",
          "type": "measurement",
          "probe": "loop_period_seconds",
          "expected": 1,
          "tolerance": 0.1,
          "unit": "s"
        }
      ],
      "safety": "教学仿真由确定性循环模型给出；真实改线前先断电，确认电源与限流。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "呼吸灯、按键点灯、报警器长鸣，三种效果分别该怎么组织代码？",
      "options": [
        {
          "id": "a",
          "text": "呼吸灯=循环+延时；按键点灯=if 判断；报警器=循环+时间戳",
          "correct": true,
          "why": "重复节奏用循环，状态切换用判断，长鸣要周期没有终点。"
        },
        {
          "id": "b",
          "text": "全部用 for 循环，次数写大一点",
          "correct": false,
          "why": "次数不是语义，按键和报警的终止条件不是「次数」。"
        },
        {
          "id": "c",
          "text": "全部用 while 循环加一个永不满足的条件",
          "correct": false,
          "why": "没有终止条件的 while 会卡死主循环。"
        }
      ],
      "solution": "先想「重复什么、什么时候停」，再选循环与判断；亮灭必须成对。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "循环让灯呼吸，循环必须有边界。",
        "亮和灭是成对动作，缺一个就会卡在某一态。",
        "先写终止条件，再写循环体。"
      ]
    }
  ],
  "checks": [
    {
      "id": "c1",
      "type": "code",
      "weight": 0.4,
      "pass": "循环 3 次、亮灭各 0.5s、无死循环"
    },
    {
      "id": "m1",
      "type": "measurement",
      "weight": 0.3,
      "pass": "峰值 3.3V ± 0.2V、周期 1.0s ± 0.1s"
    },
    {
      "id": "q1",
      "type": "quiz",
      "weight": 0.3,
      "pass": "能说明循环边界与亮灭配对的关系"
    }
  ],
