{
  "schema": "lesson.v1",
  "lessonId": "L-K5-02",
  "kp": {
    "id": "K5-02",
    "name": "HTTP与JSON",
    "layer": "L5",
    "pillar": "echo",
    "oneLiner": "请求要有格式，数据要有结构",
    "prereq": ["K5-01"],
    "storyScene": "P10-DataExchange",
    "spoilerLevel": 4,
    "license": "CC-BY-4.0",
    "status": "planned"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "echo-market"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 35,
      "narration": "数据交换台回了一串大括号，弥让你找出「灯亮没亮、温度多少」。第一个问题：这串东西是什么格式？",
      "interaction": "choice",
      "choices": [
        { "id": "a", "text": "先看 Content-Type 与状态码，再解析 JSON", "correct": true, "feedback": "对。先确认对方说的是什么话，再翻译。" },
        { "id": "b", "text": "直接用逗号切字符串", "correct": false, "feedback": "嵌套结构会被切坏。" },
        { "id": "c", "text": "把整个响应原样打印，不需要解析", "correct": false, "feedback": "不解析就拿不到值。" }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "HTTP 是一次「请求—响应」：请求行（方法 URL 版本）、请求头、请求体；响应有状态码（2xx 成功、4xx 你的问题、5xx 对方问题）和响应头。数据常放 JSON 里：键值对、数组、嵌套对象，键与字符串用双引号。Content-Type 为 application/json 时按 JSON 解析。读数据要按层级走：`response.lamp`、`response.temp`，不是全文搜索。",
      "media": [
        {
          "kind": "diagram",
          "src": "assets/lessons/K5-02/http-json.svg",
          "alt": "HTTP 请求响应结构与 JSON 层级示意",
          "status": "planned",
          "license": "original",
          "notes": "原创 SVG，UI 内联"
        },
        {
          "kind": "simulation",
          "src": "assets/lessons/K5-02/http-client.json",
          "alt": "请求仿真：构造 GET、读状态码、解析 JSON 字段",
          "status": "planned",
          "license": "original",
          "notes": "页面内确定性仿真"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 205,
      "task": "在数据交换台发一次 GET，解析 `{lamp:1,temp:24.0}`；再发一次错误路径观察 404。",
      "steps": [
        { "action": "build", "target": "http-request", "hint": "方法、URL、头要齐全" },
        { "action": "send", "target": "http-send", "hint": "发出去并读状态码" },
        { "action": "parse", "target": "http-json-parse", "hint": "按层级取 lamp 与 temp" },
        { "action": "error", "target": "http-404", "hint": "错误路径应返回 404" }
      ],
      "failureHints": [
        "把 404 当成成功：状态码必须先判断",
        "用单引号写 JSON 键：解析失败",
        "全文搜索 temp：嵌套结构里可能取错"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 140,
      "checks": [
        { "id": "v_code", "type": "measurement", "probe": "http_status", "expected": 200, "tolerance": 0, "unit": "status" },
        { "id": "v_lamp", "type": "measurement", "probe": "http_lamp", "expected": 1, "tolerance": 0, "unit": "value" },
        { "id": "v_temp", "type": "measurement", "probe": "http_temp", "expected": 24.0, "tolerance": 0.1, "unit": "°C" }
      ],
      "safety": "教学仿真访问本地模拟接口；真实请求不得携带真实凭据，调试日志须脱敏，禁止把口令写进 URL。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "响应是 `{\"a\":{\"b\":[1,2]}}`，怎么取到 2？",
      "options": [
        { "id": "a", "text": "a.b[1]", "correct": true, "why": "先取 a，再取 b 数组第二个元素（下标从 0 起）。" },
        { "id": "b", "text": "a.b[2]", "correct": false, "why": "数组下标从 0 开始，[2] 越界。" },
        { "id": "c", "text": "全文匹配数字 2", "correct": false, "why": "嵌套里可能还有别的 2，不唯一。" }
      ],
      "solution": "按层级 a → b → 下标 1；结构越深，越要按路径取值。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "先看状态码，再看 Content-Type。",
        "JSON 按层级取值，不做全文搜索。",
        "HTTP 是请求—响应，不是函数调用。"
      ]
    }
  ],
  "checks": [
    { "id": "c1", "type": "code", "weight": 0.4, "pass": "请求构造与 JSON 解析代码正确" },
    { "id": "q1", "type": "quiz", "weight": 0.3, "pass": "状态码语义与 JSON 结构判断正确" },
    { "id": "m1", "type": "measurement", "weight": 0.3, "pass": "状态码 200、lamp=1、temp=24.0±0.1" }
  ],
  "assessment": {
    "masteryWeights": { "hook": 0.1, "practice": 0.35, "verify": 0.3, "transfer": 0.25 },
