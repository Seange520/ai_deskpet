{
  "schema": "lesson.v1",
  "lessonId": "L-K2-05",
  "kp": {
    "id": "K2-05",
    "name": "逻辑门与真值表",
    "layer": "L2",
    "pillar": "forge",
    "oneLiner": "门电路是判决书",
    "prereq": [
      "K2-01"
    ],
    "storyScene": "P10-VerificationRoom",
    "spoilerLevel": 2,
    "license": "CC-BY-4.0",
    "status": "sample"
  },
  "meta": {
    "version": "0.1.0",
    "updatedAt": "2026-11-09",
    "author": "DSH-Lead",
    "estimatedMinutes": 11,
    "template": "six-segment-v1",
    "gameMount": "street-p10"
  },
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 35,
      "narration": "校验室的门禁有两个检查点：温度和电流都在范围内，门才允许打开。摊主想用一根线把两个开关并在一起：随便哪个过了都放行。赫菲把线拿开：那是「或」，不是「与」。你想放进来的是什么？",
      "interaction": "choice",
      "choices": [
        {
          "id": "a",
          "text": "用「与」门：两个条件都满足才放行",
          "correct": true,
          "feedback": "对。安全联锁要的是全部满足，不是任一个满足。"
        },
        {
          "id": "b",
          "text": "用「或」门：任一条件满足就放行",
          "correct": false,
          "feedback": "任一满足就放行，会把异常也放进去。"
        },
        {
          "id": "c",
          "text": "不用门，直接短接两个开关",
          "correct": false,
          "feedback": "短接等于取消检查，门形同虚设。"
        }
      ]
    },
    {
      "id": "explain",
      "type": "explain",
      "durationSec": 100,
      "narration": "逻辑门是把输入的高低电平按规则组合成输出的元件。与门：两个都为高，输出才为高；或门：任一个为高，输出就为高；非门：把高变低、低变高；与非门：与门再取反；异或门：两个不同才为高。把输入的所有组合与对应输出列成表，就是真值表，它是门电路的判决书，也是从需求反推门类型的工具。安全联锁有两种习惯写法：全部条件满足才允许动作，用与门；任一异常就切断，用与非门。德摩根定律告诉我们「非（A 且 B）」等于「非 A 或 非 B」，改条件时可以少绕弯。",
      "media": [
        {
          "kind": "card",
          "src": "assets/lessons/K2-05/logic-gates-truth-table.svg",
          "alt": "与/或/非/与非/异或五门符号与真值表",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        },
        {
          "kind": "diagram",
          "src": "assets/lessons/K2-05/gate-sim.svg",
          "alt": "DOM 门电路仿真：拨动两个输入开关，观察门符号与输出灯状态",
          "status": "ready",
          "license": "CC-BY-4.0",
          "notes": "T1.1 原创 SVG，静音可用"
        }
      ]
    },
    {
      "id": "practice",
      "type": "practice",
      "durationSec": 210,
      "task": "完成 3 项任务：① 填与门、或门、异或门三张真值表 ② 给「两个都到位才上电」选门 ③ 用德摩根改写一条联锁条件。",
      "steps": [
        {
          "action": "fill",
          "target": "truth-and",
          "hint": "只有 1 与 1 输出 1"
        },
        {
          "action": "fill",
          "target": "truth-or",
          "hint": "有一个 1 就输出 1"
        },
        {
          "action": "fill",
          "target": "truth-xor",
          "hint": "不同才为 1"
        },
        {
          "action": "choose",
          "target": "interlock-gate",
          "hint": "全部满足才动作，用与门"
        },
        {
          "action": "rewrite",
          "target": "demorgan",
          "hint": "非（A 且 B）= 非 A 或 非 B"
        }
      ],
      "failureHints": [
        "把或门当选型答案：任一满足就放行是危险逻辑",
        "真值表行序乱：按 00/01/10/11 固定顺序填",
        "德摩根改写时忘记对每个变量取反"
      ]
    },
    {
      "id": "verify",
      "type": "verify",
      "durationSec": 140,
      "checks": [
        {
          "id": "v_nand",
          "type": "measurement",
          "probe": "nand_output",
          "expected": 0.2,
          "tolerance": 0.3,
          "unit": "V"
        },
        {
          "id": "v_table",
          "type": "quiz",
          "ask": "与门真值表输出序列（00/01/10/11）",
          "expected": [
            0,
            0,
            0,
            1
          ]
        }
      ],
      "safety": "逻辑实验统一用 3.3V 供电；接线前断电，门电路电源不得反接；不要在带电状态下插拔集成块。"
    },
    {
      "id": "transfer",
      "type": "transfer",
      "durationSec": 150,
      "prompt": "要求「任意一个异常就立刻切断总电源」，下列实现最合适的是？",
      "options": [
        {
          "id": "or",
          "text": "把异常信号用或门汇总，输出直接去切断",
          "correct": false,
          "why": "或门是「任一异常为高」，但切断逻辑极性要考虑失效安全。"
        },
        {
          "id": "nand",
          "text": "用与非门：所有「正常」信号都为高时输出低，任一异常则输出高去切断",
          "correct": true,
          "why": "与非门把「全部正常」取反，天然适配失效安全切断。"
        },
        {
          "id": "not",
          "text": "只用一个非门，任取一个异常信号",
          "correct": false,
          "why": "一个信号管不住多个异常源。"
        }
      ],
      "solution": "失效安全切断要把「全部正常」整体取反：所有正常信号相与后再取反，即与非门。任一异常变为低，输出就翻转为切断。"
    },
    {
      "id": "recap",
      "type": "recap",
      "durationSec": 30,
      "lines": [
        "与门全部为高才输出高；或门任一为高就输出高；异或门不同才为高。",
        "真值表是判决书：需求先写成表，再反推门。",
        "安全联锁：全部满足用与门，任一异常切断用与非门。"
      ]
    }
  ],
  "checks": [
    {
      "id": "q1",
      "type": "quiz",
